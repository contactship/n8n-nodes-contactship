            "Contact": "={{ $json.data.contact?.full_name ?? '' }}",
            "Phone": "={{ $json.data.contact?.phone_number || $json.data.call.to_number || '' }}",
            "Duration (s)": "={{ Number($json.data.call.duration) || 0 }}",
            "Summary": "={{ $json.data.call.call_analysis?.call_summary ?? '' }}",
