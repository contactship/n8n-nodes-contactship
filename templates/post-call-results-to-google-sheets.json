            "Successful": "={{ $json.data.call.call_analysis?.call_successful ?? '' }}",
            "Extracted Data": "={{ JSON.stringify($json.data.call.call_analysis?.custom_analysis_data ?? {}) }}",
            "Recording": "={{ $json.data.call.recording_url ?? '' }}",
            "Agent": "={{ $json.data.agent?.name ?? '' }}"
