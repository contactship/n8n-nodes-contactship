{
	"name": "n8n-nodes-contactship",
	"version": "1.0.0",
	"description": "n8n nodes for ContactShip: make AI phone calls, manage contacts, boards and tasks, send WhatsApp messages and events, and trigger workflows from post-call results.",
	"license": "MIT",
	"homepage": "https://github.com/contactship/n8n-nodes-contactship#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"contactship",
		"ai phone call",
		"voice agent",
		"whatsapp",
		"contact center",
		"crm"
	],
	"author": {
		"name": "ContactShip",
		"email": "support@contactship.ai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contactship/n8n-nodes-contactship.git"
	},
	"bugs": {
		"url": "https://github.com/contactship/n8n-nodes-contactship/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ContactShipApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ContactShip/ContactShip.node.js",
			"dist/nodes/ContactShipTrigger/ContactShipTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
